<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>pt.piscapisca.b2c.asset.processor</groupId>
  <artifactId>asset-processor</artifactId>
  <version>1.0-SNAPSHOT</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>pt.piscapisca.b2c.asset.processor.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>libs-release-local</id>
      <name>libs-release-local</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/credibom-release-local/</url>
    </repository>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>libs-snapshot-local</id>
      <name>libs-snapshot-local</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/credibom-snapshot-local/</url>
    </repository>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>libs-release</id>
      <name>libs-release</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/maven-releases/</url>
    </repository>
    <repository>
      <snapshots />
      <id>libs-snapshot</id>
      <name>libs-snapshot</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/maven-snapshots/</url>
    </repository>
  </repositories>
  <distributionManagement>
    <repository>
      <id>b2c-releases</id>
      <name>libs-release-local</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/credibom-release-local/</url>
    </repository>
    <snapshotRepository>
      <id>b2c-snapshots</id>
      <name>libs-snapshot-local</name>
      <url>https://nexus.devtools.awsdomain.crb/repository/credibom-snapshot-local/</url>
    </snapshotRepository>
  </distributionManagement>
  <properties>
    <hibernate.validator.version>8.0.0.Final</hibernate.validator.version>
    <aws.apache.client.version>2.54.7</aws.apache.client.version>
    <jackson.version>2.22.2</jackson.version>
    <picocli.version>4.7.7</picocli.version>
    <slf4j.version>2.0.18</slf4j.version>
    <amazon.awssdk.version>2.54.7</amazon.awssdk.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <commons.utils.version>0.7.61</commons.utils.version>
    <aws.sso.version>2.54.7</aws.sso.version>
    <logback.version>1.6.3</logback.version>
    <dotenv.version>3.2.0</dotenv.version>
    <caffeine.version>3.2.4</caffeine.version>
    <jooq.version>3.21.7</jooq.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <jackson.module.jakarta.version>2.22.2</jackson.module.jakarta.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <jakarta.validation.version>3.1.1</jakarta.validation.version>
    <postgresql.version>42.7.13</postgresql.version>
  </properties>
</project>
